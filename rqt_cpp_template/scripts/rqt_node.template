import sys

from rqt_gui.main import Main


def add_arguments(parser):
    group = parser.add_argument_group('Options for %(PACKAGE_NAME)s plugin')
    group.add_argument('topic', nargs='?', help='The topic name to subscribe to')

main = Main()
sys.exit(main.main(
    sys.argv,
    standalone='%(PACKAGE_NAME)s/%(CAMEL_CASE_PACKAGE_NAME)sPlugin',
    plugin_argument_provider=add_arguments))
