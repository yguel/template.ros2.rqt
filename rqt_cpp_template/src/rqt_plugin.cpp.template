#include <QStringList>
#include <memory>
#include <thread>

#include "pluginlib/class_list_macros.hpp"
#include "rclcpp/rclcpp.hpp"

#include "%(PACKAGE_NAME)s/rqt_plugin.hpp"

using std::placeholders::_1;

#ifndef CLASSM
#define CLASSM %(CAMEL_CASE_PACKAGE_NAME)sPlugin
#else
#error alias CLASSM all ready defined!
#endif

namespace %(PACKAGE_NAME)s
{

CLASSM::%(CAMEL_CASE_PACKAGE_NAME)sPlugin()
  : rqt_gui_cpp::Plugin(),
  mw_(0)
{
  setObjectName("%(OBJECT_HUMAN_NAME)s");
}

void CLASSM::initPlugin(qt_gui_cpp::PluginContext & context)
{
  // Access standalone command line arguments
  QStringList argv = context.argv();
  // Create QMainWindow
  mw_ = new QMainWindow();
  // Extend the widget with all attributes and children from UI file
  ui_.setupUi(mw_);
  // Set the title for the widget (the value in the ui file will be used whatever string is provided as parameter)
  mw_->setObjectName("%(OBJECT_HUMAN_NAME)s");
  // Add widget to the user interface
  context.addWidget(mw_);

  if (0 == context.serialNumber() ) {
    // 0 means this is a standalone window
    // 1 means it is a docked window

    // Defer the standalone check and window title set
    QTimer::singleShot(
      0, mw_, [this]() {
        QWidget * topLevel = mw_;
        while (topLevel && topLevel->parentWidget()) {
          topLevel = topLevel->parentWidget();
        }
        if (topLevel && topLevel->inherits("QMainWindow")) {
          topLevel->setWindowTitle(
            "%(STANDALONE_WINDOW_TITLE)s");
        }
      });

  }

  // TODO(%(PACKAGE_MAINTAINER_EMAIL)s): Create subscribers and publishers here

  // TODO(%(PACKAGE_MAINTAINER_EMAIL)s): Connect signals to slots from and to the UI widgets
}

void CLASSM::shutdownPlugin()
{
  // TODO(%(PACKAGE_MAINTAINER_EMAIL)s): unregister all publishers here
}

void CLASSM::saveSettings(
  qt_gui_cpp::Settings & plugin_settings,
  qt_gui_cpp::Settings & instance_settings) const
{
  // TODO(%(PACKAGE_MAINTAINER_EMAIL)s): save intrinsic configuration, usually using:
  // instance_settings.setValue(k, v)
  (void) plugin_settings;
  (void) instance_settings;
}

void CLASSM::restoreSettings(
  const qt_gui_cpp::Settings & plugin_settings,
  const qt_gui_cpp::Settings & instance_settings)
{
  // TODO(%(PACKAGE_MAINTAINER_EMAIL)s): restore intrinsic configuration, usually using:
  // v = instance_settings.value(k)
  (void) plugin_settings;
  (void) instance_settings;

  // Restore the title for the widget (the value in the ui file will be used whatever string is provided as parameter)
  mw_->setObjectName("%(OBJECT_HUMAN_NAME)s");
}

}  // < namespace %(PACKAGE_NAME)s
PLUGINLIB_EXPORT_CLASS(%(PACKAGE_NAME)s::CLASSM, rqt_gui_cpp::Plugin)

#undef CLASSM
